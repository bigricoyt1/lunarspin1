rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'palmerrico500@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['admin', 'owner'])
      );
    }

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.email == 'palmerrico500@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['admin', 'owner', 'dev', 'mod', 'helper'])
      );
    }

    // User collection
    match /users/{userId} {
      allow read: if true; 
      allow create: if (isSignedIn() && request.auth.uid == userId) || userId.startsWith('discord_') || userId.startsWith('demo_') || userId.startsWith('google_') || userId.startsWith('custom_');
      allow update: if (isSignedIn() && (request.auth.uid == userId || isStaff())) || userId.startsWith('discord_') || userId.startsWith('demo_') || userId.startsWith('google_') || userId.startsWith('custom_');
      allow delete: if isAdmin();
    }

    // Requests collection
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Promos collection
    match /promos/{promoId} {
      allow read: if true;
      allow write: if true;
    }

    // Config collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.username != null;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // Bets collection
    match /bets/{betId} {
      allow read: if true;
      allow create: if true;
    }

    // Case Battles collection
    match /battles/{battleId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // Community Cases collection
    match /cases/{caseId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Official Cases collection
    match /official_cases/{caseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bans collection
    match /bans/{banId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
